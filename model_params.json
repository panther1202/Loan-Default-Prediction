  "derived_features": {
    "EstimatedEMI": "if InterestRate == 0: LoanAmount / LoanTerm; else: LoanAmount * r * (1+r)^n / ((1+r)^n - 1), where r = InterestRate/12/100, n = LoanTerm (months)",
    "Payment_to_Income_Ratio": "EstimatedEMI / (Income + 1e-6)"
  },
  "prediction_formula": "clamp each raw numeric feature to outlier_bounds.bounds[f]; then derive EstimatedEMI and Payment_to_Income_Ratio from the clamped values; then p_default = sigmoid(intercept + sum(coefficients[f] * standardized_or_encoded_value[f] for f in feature_order)); standardize numeric features as (clamped_or_derived - scaler.mean[f]) / scaler.scale[f]; categorical dummy value is 1.0 if that category is present else 0.0, and the dropped_category for each column maps to all-zeros.",
