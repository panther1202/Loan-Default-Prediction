{
  "permissions": {
    "deny": [
      "Edit(app.py)",
      "Edit(model_params.json)",
      "Edit(**/*.pkl)",
      "Edit(data/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard_model_artifacts.py\"",
            "timeout": 10,
            "statusMessage": "Checking ADR-0008 model-artifact guard"
          }
        ]
      }
    ]
  }
}
